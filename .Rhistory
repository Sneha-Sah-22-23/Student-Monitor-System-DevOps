# Convert Timestamp to proper format
data$Timestamp <- as.POSIXct(data$Timestamp, format="%Y-%m-%d %H:%M:%S")
# Extract time (hour)
data$Hour <- format(data$Timestamp, "%H")
# Count distraction frequency
summary_data <- data %>%
group_by(Hour, Status) %>%
summarise(count = n())
# Plot graph
